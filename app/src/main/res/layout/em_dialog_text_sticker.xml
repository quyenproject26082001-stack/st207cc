<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:layoutDirection="ltr">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/verLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <ImageView
        android:id="@+id/btnColorPicker"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="12dp"
        android:padding="4dp"
        android:src="@drawable/ic_color_picker_unselected"
        app:layout_constraintEnd_toEndOf="@id/verLine"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnTextFont"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="50dp"
        android:padding="4dp"
        android:src="@drawable/ic_text_font_selected"
        app:layout_constraintStart_toStartOf="@id/verLine"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btnDone"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14sp"
        android:fontFamily="@font/nunito_bold"
        android:gravity="center"
        android:layoutDirection="ltr"
        android:text="@string/done"
        android:textColor="@color/white"
        android:textDirection="ltr"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/btnTextFont"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnTextFont" />


        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14sp"
            android:fontFamily="@font/nunito_bold"
            android:gravity="center"
            android:layoutDirection="ltr"
            android:text="@string/done"
            android:textColor="@color/white"
            android:textDirection="ltr"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/btnTextFont"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnTextFont" />

    <EditText
        android:id="@+id/edtText"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginVertical="20dp"
        android:background="@color/transparent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:imeOptions="actionNone"
        android:inputType="textMultiLine"
        android:layoutDirection="ltr"
        android:maxLength="30"
        android:maxLines="2"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_10sdp"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textDirection="ltr"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@id/layoutRcv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnTextFont" />

    <FrameLayout
        android:id="@+id/layoutRcv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvTextFont"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:visibility="gone"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_font" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvTextColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layoutDirection="ltr"
            android:visibility="visible"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_text_color_emoji" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvLength"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_davy_gray_corner_20"
        android:fontFamily="@font/nunito_bold"
        android:layoutDirection="ltr"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="0/30"
        android:textAlignment="center"
        android:textColor="#A6FFFFFF"
        android:textDirection="ltr"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/layoutRcv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>

