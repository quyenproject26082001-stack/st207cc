<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    tools:context=".ui.customize.CustomizeCharacterActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#A1CCEF"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@id/gl056" />

    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <!-- Layout Image Layer -->
    <com.pony.avatar.ocmaker.core.custom.drawview.DrawView
        android:id="@+id/layoutCustomLayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toTopOf="@+id/rcvLayer"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar" />

    <!--    gl056-->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl056"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.7" />

    <!--    btnFlip-->
    <ImageView
        android:id="@+id/btnFlip"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_flip"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar" />

    <!--    btnHide-->
    <ImageView
        android:id="@+id/btnHide"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_show"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnFlip" />


    <ImageView
        android:id="@+id/btnFlipH"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_flip_emoji_h"
        app:layout_constraintBottom_toTopOf="@+id/rcvLayer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnFlipV"
        android:layout_marginBottom="7dp"
        android:layout_marginStart="20dp"/>

    <ImageView
        android:id="@+id/btnFlipV"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_flip_emoji_v"
        app:layout_constraintEnd_toStartOf="@id/btnDraw"
        app:layout_constraintBottom_toTopOf="@+id/rcvLayer"
        app:layout_constraintStart_toEndOf="@id/btnFlipH"
        android:layout_marginBottom="7dp"

        />

    <ImageView
        android:id="@+id/btnDraw"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_draw"
        app:layout_constraintBottom_toTopOf="@+id/rcvLayer"
        app:layout_constraintStart_toEndOf="@id/btnFlipV"
        android:layout_marginBottom="7dp"
        app:layout_constraintEnd_toStartOf="@id/btnText"
        />

    <ImageView
        android:id="@+id/btnText"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_text_emoji"
        app:layout_constraintBottom_toTopOf="@+id/rcvLayer"
        app:layout_constraintStart_toEndOf="@id/btnDraw"
        android:layout_marginBottom="7dp"
        app:layout_constraintEnd_toStartOf="@id/btnLayer"
        />

    <ImageView
        android:id="@+id/btnLayer"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_layer"
        app:layout_constraintBottom_toTopOf="@+id/rcvLayer"
        app:layout_constraintStart_toEndOf="@id/btnText"
        android:layout_marginBottom="7dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
      />


    <!--    rcvLayer-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvLayer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#EBFFD0"
        android:layerType="hardware"
        android:paddingHorizontal="9.5dp"
        android:paddingTop="16dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gl056"
        app:spanCount="5"
        tools:listitem="@layout/item_customize" />



    <!--    flBottomNav-->
    <FrameLayout
        android:id="@+id/flBottomNav"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="0dp"
        android:clipChildren="false"
        android:background="@drawable/bg_navi_bottom"
        app:layout_constraintBottom_toBottomOf="parent">

        <!--        rcvNavigation-->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:clipToPadding="false"
            android:foregroundGravity="center"
            android:layerType="hardware"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_bottom_navigation" />
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>