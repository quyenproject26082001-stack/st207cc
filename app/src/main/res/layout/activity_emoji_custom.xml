<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    tools:context=".ui.emoji_custom.EmojiCustomActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#A1CCEF"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@id/gl056" />

    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <!-- Draw toolbar (covers action bar during draw mode) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutToolbarDraw"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        android:elevation="5dp"
        android:paddingTop="36dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/layoutActionBar"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnDrawCancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Draw"
            android:textSize="20sp"
            android:textColor="@color/jet"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/btnDrawDone"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="Done"
            android:textSize="16sp"
            android:textColor="@color/spiro_disco_ball"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="@id/btnDrawCancel"
            app:layout_constraintBottom_toBottomOf="@id/btnDrawCancel"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Layout Image Layer -->
    <com.catmaker.leuleu.core.custom.drawview.DrawView
        android:id="@+id/layoutCustomLayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toTopOf="@+id/rcvLayer"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar" />

    <!-- Paint Draw View (for drawing) -->
    <com.catmaker.leuleu.core.custom.paintview.PaintDrawView
        android:id="@+id/paintDrawView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/layoutCustomLayer"
        app:layout_constraintEnd_toEndOf="@+id/layoutCustomLayer"
        app:layout_constraintStart_toStartOf="@+id/layoutCustomLayer"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar" />

    <!-- Dark overlay on canvas when adjusting color/size -->
    <View
        android:id="@+id/viewDraw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:elevation="1dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/layoutToolbarDraw"
        app:layout_constraintBottom_toTopOf="@+id/layoutDrawControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Gradient overlay above draw controls -->
    <View
        android:id="@+id/viewDrawGradient"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/view_gradient_transparent_black"
        android:elevation="1dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/layoutDrawControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Drawing Controls Layout (Bottom Sheet) -->
    <LinearLayout
        android:id="@+id/layoutDrawControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Drag handle -->
        <View
            android:layout_width="56dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_water_corner_50" />

        <!-- Mode label -->
        <TextView
            android:id="@+id/tvMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pen"
            android:textAlignment="center"
            android:textColor="@color/jet"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Color Picker (shown in Pen mode) -->
        <LinearLayout
            android:id="@+id/layoutColorPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="999dp"
                app:cardElevation="0dp">

                <com.skydoves.colorpickerview.ColorPickerView
                    android:id="@+id/colorPicker"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp">

                <com.skydoves.colorpickerview.sliders.AlphaSlideBar
                    android:id="@+id/sbAlphaSlideBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:borderColor_AlphaSlideBar="@android:color/transparent" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp">

                <com.skydoves.colorpickerview.sliders.BrightnessSlideBar
                    android:id="@+id/sbBrightnessSlide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:borderColor_BrightnessSlider="@android:color/transparent" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Size Seekbar -->
        <LinearLayout
            android:id="@+id/layoutSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:weightSum="10"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Size"
                android:textSize="14sp"
                android:textColor="@color/jet"
                android:textStyle="bold"
                android:gravity="end"
                android:paddingEnd="8dp" />

            <SeekBar
                android:id="@+id/sbSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="9"
                android:max="99"
                android:progress="50"
                android:progressDrawable="@drawable/bg_seekbar_draw"
                android:thumb="@drawable/bg_thumb_seekbar_draw" />
        </LinearLayout>

        <!-- Pen / Eraser toggle buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btnPen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_draw_selected"
                android:padding="8dp"
                android:src="@drawable/ic_paint"
                android:layout_marginEnd="24dp"
                app:tint="@color/spiro_disco_ball" />

            <ImageView
                android:id="@+id/btnEraser"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_draw_unselected"
                android:padding="8dp"
                android:src="@drawable/ic_eraser"
                app:tint="@color/davy_grey" />
        </LinearLayout>

    </LinearLayout>

    <!--    gl056-->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl056"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.7" />

    <!--    btnFlip-->
    <ImageView
        android:id="@+id/btnFlip"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_flip"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar" />

    <!--    btnHide-->
    <ImageView
        android:id="@+id/btnHide"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_show"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnFlip" />


    <ImageView
        android:id="@+id/btnFlipH"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_flip_emoji_h"
        app:layout_constraintBottom_toTopOf="@+id/rcvLayer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnFlipV"
        android:layout_marginBottom="7dp"
        android:layout_marginStart="20dp"/>

    <ImageView
        android:id="@+id/btnFlipV"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_flip_emoji_v"
        app:layout_constraintEnd_toStartOf="@id/btnDraw"
        app:layout_constraintBottom_toTopOf="@+id/rcvLayer"
        app:layout_constraintStart_toEndOf="@id/btnFlipH"
        android:layout_marginBottom="7dp"

        />

    <ImageView
        android:id="@+id/btnDraw"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_draw"
        app:layout_constraintBottom_toTopOf="@+id/rcvLayer"
        app:layout_constraintStart_toEndOf="@id/btnFlipV"
        android:layout_marginBottom="7dp"
        app:layout_constraintEnd_toStartOf="@id/btnText"
        />

    <ImageView
        android:id="@+id/btnText"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_text_emoji"
        app:layout_constraintBottom_toTopOf="@+id/rcvLayer"
        app:layout_constraintStart_toEndOf="@id/btnDraw"
        android:layout_marginBottom="7dp"
        app:layout_constraintEnd_toStartOf="@id/btnLayer"
        />

    <ImageView
        android:id="@+id/btnLayer"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_layer"
        app:layout_constraintBottom_toTopOf="@+id/rcvLayer"
        app:layout_constraintStart_toEndOf="@id/btnText"
        android:layout_marginBottom="7dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
      />


    <!--    rcvLayer-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvLayer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#EBFFD0"
        android:layerType="hardware"
        android:paddingHorizontal="9.5dp"
        android:paddingTop="16dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/flBottomNav"
        app:layout_constraintTop_toBottomOf="@+id/gl056"
        app:spanCount="5"
        tools:listitem="@layout/item_customize" />



    <!--    flBottomNav-->
    <FrameLayout
        android:id="@+id/flBottomNav"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="0dp"
        android:clipChildren="false"
        android:background="@drawable/bg_navi_bottom"
        app:layout_constraintBottom_toBottomOf="parent">

        <!--        rcvNavigation-->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:clipToPadding="false"
            android:foregroundGravity="center"
            android:layerType="hardware"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_bottom_navigation" />
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>